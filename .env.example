
# Application
APP_NAME=araya-business-hub
APP_ENV=development
APP_PORT=8080

# PostgreSQL Database (Supabase: pakai Session pooler, port 5432)
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_SSLMODE=require

# Authentication / JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS: daftar origin frontend dipisah koma, atau * untuk semua
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Admin awal (dipakai `go run ./cmd/seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=your_admin_password

# Kata sandi semua akun data demo (dipakai `go run ./cmd/seed-demo`)
DEMO_PASSWORD=your_demo_password
